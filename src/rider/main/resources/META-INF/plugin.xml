<idea-plugin require-restart="true">
    <id>com.jetbrains.rider.plugins.cleanarchtool</id>
    <name>CleanArchTool</name>
    <version>_PLACEHOLDER_</version>
    <vendor url="https://github.com/StanslawStepkas28016/ReSharperPlugin.CleanArchTool">Author</vendor>
    <idea-version since-build="_PLACEHOLDER_" until-build="_PLACEHOLDER_"/>
    <depends>com.intellij.modules.rider</depends>

    <description>
        <![CDATA[<p>Adds option pages to the settings dialog.</p>]]>
    </description>

    <actions resource-bundle="messages.RiderPluginActionsBundle">
        <group id="CleanArchTool.Group" text="CleanArchTool" icon="CleanArchToolThemedIcons.Icon">
            <add-to-group group-id="MainToolbarRight" anchor="first"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="ManagePluginSettingsAction"
                    class="com.jetbrains.rider.plugins.cleanarchtool.actions.ManagePluginSettingsAction"
                    icon="CleanArchToolThemedIcons.Icon">
                <keyboard-shortcut keymap="$default" first-keystroke="shift control G"/>
            </action>
        </group>
    </actions>

</idea-plugin>
