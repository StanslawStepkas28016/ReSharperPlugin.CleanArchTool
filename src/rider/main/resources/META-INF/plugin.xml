<idea-plugin require-restart="true">
    <id>com.jetbrains.rider.plugins.cleanarchtool</id>
    <name>CleanArchTool</name>
    <version>_PLACEHOLDER_</version>
    <vendor url="https://project-url">Author</vendor>
    <idea-version since-build="_PLACEHOLDER_" until-build="_PLACEHOLDER_"/>
    <depends>com.intellij.modules.rider</depends>

    <description>
        <![CDATA[<p>Adds option pages to the settings dialog.</p>]]>
    </description>

    <extensions defaultExtensionNs="com.intellij">
        <!-- https://plugins.jetbrains.com/docs/intellij/settings-guide.html#values-for-parent-id-attribute -->
        <applicationConfigurable
                parentId="tools"
                instance="com.jetbrains.rider.plugins.cleanarchtool.options.MainPage"
                id="MainPage"
                bundle="messages.OptionPagesBundle"
                key="configurable.name.optionpages.options.title" />
    </extensions>

</idea-plugin>
